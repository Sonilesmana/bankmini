rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AWAL (uji coba): baca tulis terbuka agar cepat jalan.
    // Setelah petugas + nasabah bisa akses, KETATKAN jadi di bawah.
    match /students/{id} { allow read: if true; allow write: if true; }
    match /transactions/{id} { allow read: if true; allow write: if true; }

    // VERSI KETAT (disarankan, jika sudah buat 1 akun di Authentication):
    // match /students/{id} { allow read: if true; allow write: if request.auth != null; }
    // match /transactions/{id} { allow read: if true; allow write: if request.auth != null; }
  }
}
